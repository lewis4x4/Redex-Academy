# =============================================================================
# Redex Academy — .env.example  (NAMES ONLY — commit this file; never put real
# secret values here). Conforms to DECISIONS_LEDGER.md.
#
# HOW TO USE
#   1. Copy to `.env.local` (which is gitignored) and fill in real values.
#   2. Secrets do NOT live in any committed file or the client bundle. Put them in:
#        - Supabase Vault           → Edge Function secrets (service role, signing key, AI keys, LRS, OIDC)
#        - Cloudflare Secrets        → `wrangler secret put NAME` (R2/Stream/account token, signing key for the verify Worker)
#        - Netlify environment       → CI/build + server runtime
#   3. ONLY `VITE_*` values are safe to expose in the browser bundle. Everything
#      else is server-only (Edge Functions / Workers / CI). Never prefix a secret with VITE_.
#   4. Greenfield decision (ledger §A): ONE Supabase project, schemas `academy` + `workos`,
#      shared `auth.users`. There are deliberately NO `REDEX_WORKOS_*` vars.
#   5. Ensure `.gitignore` contains: .env  .env.local  .env.*.local
#
# Values left blank → paste from the provider dashboard (source noted per line).
# Values pre-filled → non-secret config defaults; change to suit.
# =============================================================================


# -----------------------------------------------------------------------------
# CLIENT-PUBLIC  (Vite — shipped in the browser bundle; safe to expose)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=  # Supabase → Project Settings → API → Project URL
VITE_SUPABASE_ANON_KEY=  # Supabase → Project Settings → API → anon/public key
VITE_APP_BASE_URL=http://localhost:5173  # dev default; prod e.g. https://redex.education
VITE_OB_ISSUER_PROFILE_URL=https://redex.education/.well-known/issuer  # public issuer profile URL (served as a Netlify static file from apps/web/public/.well-known/issuer)
VITE_CF_STREAM_CUSTOMER_SUBDOMAIN=  # Cloudflare → Stream → customer subdomain (video playback)
VITE_SENTRY_DSN=  # Sentry DSN (publishable)
VITE_ENVIRONMENT=development             # development | staging | production


# -----------------------------------------------------------------------------
# SUPABASE  (server-only — Edge Functions / CLI / CI)
# NOTE: inside the Supabase Edge runtime, SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY are auto-injected. These entries are for local dev,
# the CLI, migrations, and CI.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=  # Project Settings → API → service_role (FULL DB access; Vault/CI ONLY — never client)
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=  # postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_PROJECT_REF=  # Supabase → Project Settings → General → Reference ID
SUPABASE_ACCESS_TOKEN=  # Supabase → Account → Access Tokens (CLI/CI)
# Reminder: expose schemas `academy,workos` in API settings; after every migration run
#   supabase gen types typescript --schema academy,workos > packages/db-types/database.types.ts


# -----------------------------------------------------------------------------
# CLOUDFLARE  (server-only — Workers / R2 / Stream / KV / D1)
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=  # Cloudflare dashboard → Account ID
CLOUDFLARE_API_TOKEN=  # scoped token: Workers + R2 + Stream + KV + D1 edit
R2_ACCESS_KEY_ID=  # R2 → Manage R2 API Tokens (S3-compatible creds)
R2_SECRET_ACCESS_KEY=  # R2 → Manage R2 API Tokens
R2_BUCKET_MEDIA=redex-academy-media       # 3D assets, sim fixtures, course packs, badge images
R2_BUCKET_EVIDENCE=redex-academy-evidence # sign-off evidence (private; signed-URL access only)
R2_S3_ENDPOINT=  # https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
CF_STREAM_API_TOKEN=  # Stream upload + signed-playback token
CF_KV_NAMESPACE_FLAGS=  # KV namespace id — feature flags
CF_KV_NAMESPACE_FIXTURES=  # KV namespace id — sim fixture manifest (which fixture version a sim loads)
CF_KV_NAMESPACE_CATALOG=  # KV namespace id — edge-cached public catalog
CF_D1_DATABASE_ID=  # D1 database id — edge read replica of catalog/prereq graph


# -----------------------------------------------------------------------------
# LEARNING RECORD STORE  (xAPI — server-only; telemetry flows via the xapi-bridge Edge Function, never the client)
# -----------------------------------------------------------------------------
LRS_ENDPOINT=  # e.g. https://lrs.internal/xapi  (Yet Analytics SQL LRS)
LRS_KEY=  # xAPI Basic-auth key/username
LRS_SECRET=  # xAPI Basic-auth secret/password
LRS_DB_URL=  # only if self-hosting the SQL LRS


# -----------------------------------------------------------------------------
# AI SERVICES  (server-only — called from Edge Functions; keys NEVER on client)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# OPEN BADGES 3.0 / VERIFIABLE CREDENTIALS ISSUER  (ledger §F)
# Signing key is the crown jewel → Supabase Vault ONLY (co-located with the issue-badge Edge Function).
# -----------------------------------------------------------------------------
OB_ISSUER_DID=did:web:redex.education  # issuer identifier (F6; resolves to https://redex.education/.well-known/did.json)
OB_ISSUER_KEY_ID=key-2026-05  # current signing-key fragment → verificationMethod did#key-2026-05 (rotate per the runbook)
OB_ISSUER_PROFILE_URL=https://redex.education/.well-known/issuer  # public issuer profile (also set VITE_OB_ISSUER_PROFILE_URL to this)
OB_PROOF_SUITE=eddsa-rdfc-2022           # pinned proof suite (Ed25519)
OB_ISSUER_PRIVATE_KEY=  # Ed25519 private signing key (secretKeyMultibase) — VAULT ONLY; never commit a value; rotate per docs/KEY_ROTATION_RUNBOOK.md
OB_ISSUER_PUBLIC_KEY=  # Ed25519 public key (publicKeyMultibase; published in the issuer profile/DID document)
OB_STATUS_LIST_URL=https://redex.education/status/1  # hosted revocation status list (BitstringStatusList / StatusList2021; served by the status-list Edge Function, proxied from /status/*)


# -----------------------------------------------------------------------------
# SSO / IDENTITY PROVIDER  (Redex staff + CCS subcontractors; server-only)
# -----------------------------------------------------------------------------
OIDC_ISSUER_URL=  # e.g. Google Workspace / Microsoft Entra issuer
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# NOTIFICATIONS & MONITORING  (server/CI)
# -----------------------------------------------------------------------------
RESEND_API_KEY=  # transactional email (or swap for SENDGRID_API_KEY)
SENTRY_AUTH_TOKEN=  # CI source-map upload (the runtime DSN is VITE_SENTRY_DSN above)
