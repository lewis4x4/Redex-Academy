{
  "name": "@redex/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Redex Academy learner/manager/admin PWA (Vite + React 18 + TS + Tailwind). App shell only at F1; offline PWA wired in F4.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts"
  },
  "dependencies": {
    "@redex/auth": "workspace:*",
    "@redex/i18n": "workspace:*",
    "@redex/sim-engine": "workspace:*",
    "@redex/sim-schemas": "workspace:*",
    "@redex/sync-core": "workspace:*",
    "@redex/ui": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "dexie": "^4.0.10",
    "i18next": "^24.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@redex/config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
