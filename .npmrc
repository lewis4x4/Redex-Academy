# pnpm configuration for the Redex Academy monorepo.
# Peers are auto-installed; we do not hard-fail on engine mismatches so the
# repo builds on current Node LTS and newer (see .nvmrc / package.json engines).
auto-install-peers=true
strict-peer-dependencies=false
engine-strict=false
# Keep node_modules isolated (no global hoisting); workspace packages are linked.
link-workspace-packages=true
