{
  "name": "redex-academy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Redex Academy — competency engine + simulation runtime (See one / Do one / Prove one). Monorepo root.",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@redex/web",
    "dev:admin": "turbo run dev --filter=@redex/admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@redex/web",
    "test:a11y": "turbo run test:a11y --filter=@redex/web",
    "test:rls": "tsx infra/rls-check.ts",
    "dag:check": "tsx infra/dag-check.ts",
    "typegen:check": "tsx infra/typegen-drift.ts",
    "fixture:gate": "tsx infra/fixture-gate.ts",
    "gen:types": "turbo run gen:types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@redex/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
