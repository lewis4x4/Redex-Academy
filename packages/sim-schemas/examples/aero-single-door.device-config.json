{
  "$schema": "https://academy.goredex.com/sim-contracts/schemas/device-config.schema.json",
  "envelope": {
    "spec_version": "1.0.0",
    "sim_id": "ac201.aero.single-door-commission",
    "engine_kind": "device_config",
    "title_i18n": "sim.ac201.aero.title",
    "competency_ids": ["b3e7c2a1-0000-4000-8000-000000000201"],
    "locales": ["en", "es"],
    "scoring": {
      "pass_threshold": 0.8,
      "safety_pass_threshold": 0.9,
      "veto_on_any_safety_failure": true,
      "veto_feedback_i18n": "sim.ac201.aero.veto",
      "veto_state": {
        "token": "safety_veto",
        "shape": "octagon",
        "label_i18n": "sim.common.state.safety_stop",
        "color_role": "danger"
      }
    },
    "state_tokens": [
      {
        "token": "pass",
        "shape": "check",
        "label_i18n": "sim.common.state.pass",
        "color_role": "success"
      },
      {
        "token": "fail",
        "shape": "cross",
        "label_i18n": "sim.common.state.fail",
        "color_role": "danger"
      },
      {
        "token": "safety_veto",
        "shape": "octagon",
        "label_i18n": "sim.common.state.safety_stop",
        "color_role": "danger"
      }
    ],
    "i18n_string_keys": [
      "sim.ac201.aero.title",
      "sim.ac201.aero.veto",
